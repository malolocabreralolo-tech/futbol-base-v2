#!/bin/bash
# futbol-base v2: el reloj de las pasadas desde el PC (futbol-base-v2-reloj.timer, cada 5 min). Aparte del de v1
# (futbol-base-reloj), que no se toca: este solo mira y lanza en el repositorio de v2.
#
# El cron de reloj.yml casi no llega (en un día GitHub entregó 10 de los ~112 ticks que tocaban). Este decide igual
# que reloj.yml, con scripts/reloj_pasadas.py, y si toca lanza reloj.yml, que vuelve a decidir en GitHub y lanza
# update.yml. Lanzar reloj.yml y no update.yml deja que desactivar reloj.yml en Actions siga parando todo.
#
# reloj_pasadas.py es la copia REVISADA que dejó instalar.sh, nunca la de main tal cual (lo que se suba a main no se
# ejecuta en el PC sin mirarlo): si la de main cambia, lo avisa en el registro y sigue con la instalada.
#
# El token de GitHub es el mismo fichero que usa el reloj de v1, leído donde está: no se copia, no se imprime, no se
# modifica, y solo le llega a gh, por su entorno (en un argumento se vería con ps).
#
# Solo habla con la API de GitHub. Una línea de registro por ejecución (journalctl --user -u futbol-base-v2-reloj).
# Un fallo (gh, red, una respuesta que no se entiende, reloj.yml desactivado por inactividad): sale con error,
# visible en systemctl --user --failed, y no lanza nada. DRY_RUN=1: decide y no lanza.
#
#   FBR2_REPO         el repositorio (por defecto malolocabreralolo-tech/futbol-base-v2)
#   FBR2_TOKEN_FILE   el fichero del token (por defecto $HOME/.config/futbol-base-reloj/token, el del reloj de v1)
set -euo pipefail
# Sin traza aunque lo lancen con bash -x (o SHELLOPTS=xtrace): enseñaría el token en cada llamada a gh.
{ set +x; } 2> /dev/null

R=${FBR2_REPO:-malolocabreralolo-tech/futbol-base-v2}
TOKEN_FILE=${FBR2_TOKEN_FILE:-$HOME/.config/futbol-base-reloj/token}
SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/futbol-base-v2-reloj

fail() { echo "error: $*" >&2; exit 1; }
first() { head -c "${2:-200}" "$1" | tr '\n' ' ' | sed 's/ *$//'; }

# v1 tiene su propio reloj y no se toca: a su repositorio, este no le pregunta ni le lanza nada.
[ "${R,,}" != malolocabreralolo-tech/futbol-base ] || fail "FBR2_REPO es el repositorio de v1 ($R): este reloj es solo para v2"

[ -s "$TOKEN_FILE" ] || fail "falta el token de GitHub en $TOKEN_FILE (es el del reloj de v1; FBR2_TOKEN_FILE para leer otro)"
token=$(< "$TOKEN_FILE") || fail "no se puede leer el token de GitHub de $TOKEN_FILE"
[ -n "${token//[[:space:]]/}" ] || fail "falta el token de GitHub en $TOKEN_FILE (el fichero está vacío)"
# Sin exportar: el token va solo en el entorno de cada gh, no en el del resto (python3 de la decisión incluido).
gh() { GH_TOKEN=$token command gh "$@"; }

KEEP="$SHARE/reloj_pasadas.py"
[ -s "$KEEP" ] && [ -s "$SHARE/reloj_pasadas.sha" ] || fail "falta $KEEP: vuelve a ejecutar pc/reloj/instalar.sh"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# 1. ¿Sigue la de main siendo la instalada? Solo para avisar: la decisión es siempre con la instalada.
note=""
if main_sha=$(gh api "repos/$R/contents/scripts/reloj_pasadas.py?ref=main" --jq .sha 2> "$TMP/api.err"); then
  [ "$main_sha" = "$(cat "$SHARE/reloj_pasadas.sha")" ] \
    || note=" AVISO: reloj_pasadas.py ha cambiado en main (${main_sha:0:8}); sigo con la instalada: revísala y vuelve a ejecutar pc/reloj/instalar.sh."
else
  note=" (no se pudo comparar reloj_pasadas.py con main: $(first "$TMP/api.err" 120))"
fi

# 2. ¿Toca? Las mismas ejecuciones de update.yml y la misma decisión que reloj.yml.
gh run list -R "$R" --workflow update.yml --limit 20 \
  --json number,event,status,conclusion,createdAt,startedAt > "$TMP/pasadas.json" 2> "$TMP/gh.err" \
  || fail "gh run list de update.yml: $(first "$TMP/gh.err")"
# -I: sin el directorio del script ni el actual en sys.path.
GITHUB_OUTPUT="$TMP/out" python3 -I "$KEEP" < "$TMP/pasadas.json" > "$TMP/decision" 2>&1 \
  || fail "reloj_pasadas: $(first "$TMP/decision" 300)"
why=$(grep -v '^::' "$TMP/decision" | head -c 400 | tr '\n' ' ' | sed 's/ *$//' || true)
case $(grep -xE 'due=(true|false)' "$TMP/out" 2> /dev/null | tail -n 1 || true) in
  due=true) ;;
  due=false) echo "$why$note"; exit 0 ;;
  *) fail "reloj_pasadas no dio su decisión (due=): $why" ;;
esac

# 3. Toca. No si reloj.yml está desactivado; ni si hay uno en cola o en marcha de hace menos de 30 min (lo lanzó
# el cron de GitHub, o este hace un tick y aún no ha creado la pasada); ni si el último acabó mal hace menos de
# 30 min (sin esto, con reloj.yml fallando, uno cada 5 min y un correo de GitHub por cada fallo). Uno sin acabar
# más viejo es un atasco y no bloquea: el nuevo espera en fila tras él (concurrency reloj-pasadas).
gh api "repos/$R/actions/workflows/reloj.yml" > "$TMP/workflow.json" 2> "$TMP/gh.err" \
  || fail "gh api del workflow reloj.yml: $(first "$TMP/gh.err")"
gh run list -R "$R" --workflow reloj.yml --limit 10 --json status,conclusion,createdAt > "$TMP/relojes.json" 2> "$TMP/gh.err" \
  || fail "gh run list de reloj.yml: $(first "$TMP/gh.err")"
block=$(python3 -I - "$TMP/workflow.json" "$TMP/relojes.json" <<'PY'
import json, sys
from datetime import datetime, timedelta, timezone
state = json.load(open(sys.argv[1])).get("state")
if state == "disabled_inactivity":       # GitHub, tras 60 días sin commits: no lo ha parado nadie
    print("INACTIVO")
    sys.exit()
if state != "active":
    print(f"reloj.yml está «{state}» en Actions")
    sys.exit()
now = datetime.now(timezone.utc)
runs = json.load(open(sys.argv[2]))
for i, run in enumerate(runs):
    ago = now - datetime.fromisoformat(run["createdAt"].replace("Z", "+00:00"))
    mins = int(ago.total_seconds() // 60)
    if run["status"] != "completed" and ago < timedelta(minutes=30):
        print(f"ya hay un reloj.yml {run['status']}, de hace {mins} min")
        break
    if i == 0 and run["status"] == "completed" and run.get("conclusion") in ("failure", "timed_out", "startup_failure") \
            and ago < timedelta(minutes=30):
        print(f"el último reloj.yml acabó en {run['conclusion']} hace {mins} min")
        break
PY
) || fail "no se entienden las respuestas de reloj.yml"
[ "$block" = INACTIVO ] && fail "GitHub desactivó reloj.yml por inactividad: gh workflow enable reloj.yml -R $R"
if [ -n "$block" ]; then
  echo "$why No se lanza: $block.$note"
  exit 0
fi
if [ "${DRY_RUN:-0}" = 1 ]; then
  echo "$why DRY_RUN: no se lanza reloj.yml.$note"
  exit 0
fi
gh workflow run reloj.yml -R "$R" --ref main > /dev/null 2> "$TMP/gh.err" \
  || fail "gh workflow run reloj.yml: $(first "$TMP/gh.err")"
echo "$why Lanzado reloj.yml.$note"
