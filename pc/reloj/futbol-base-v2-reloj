#!/bin/bash
# futbol-base v2: el reloj de las pasadas desde el PC (futbol-base-v2-reloj.timer, cada 5 min). Aparte del de v1
# (futbol-base-reloj), que no se toca: este solo mira y lanza en el repositorio de v2.
#
# El cron de reloj.yml casi no llega (en un día GitHub entregó 10 de los ~112 ticks que tocaban). Este decide igual
# que reloj.yml, con scripts/reloj_pasadas.py, y si toca una pasada del bot, el carril de las mayores o el histórico
# (los tres que lanza reloj.yml: paso 2b) lanza reloj.yml, que vuelve a decidir en GitHub y lanza lo que toque.
# Lanzar reloj.yml y no update.yml deja que desactivar reloj.yml en Actions siga parando todo.
#
# reloj_pasadas.py es la copia REVISADA que dejó instalar.sh, nunca la de main tal cual (lo que se suba a main no se
# ejecuta en el PC sin mirarlo): si la de main cambia, lo avisa en el registro y sigue con la instalada.
#
# El token de GitHub es el mismo fichero que usa el reloj de v1, leído donde está: no se copia, no se imprime, no se
# modifica, y solo le llega a gh, por su entorno (en un argumento se vería con ps).
#
# Solo habla con la API de GitHub. Una línea de registro por ejecución (journalctl --user -u futbol-base-v2-reloj).
# Un fallo (gh, red, una respuesta que no se entiende, reloj.yml desactivado por inactividad): sale con error,
# visible en systemctl --user --failed, y no lanza nada; salvo al mirar el carril o el histórico (paso 2b), que solo se
# apunta en la línea. DRY_RUN=1: decide y no lanza (y dice qué habría lanzado y por qué).
#
#   FBR2_REPO         el repositorio (por defecto malolocabreralolo-tech/futbol-base-v2)
#   FBR2_TOKEN_FILE   el fichero del token (por defecto $HOME/.config/futbol-base-reloj/token, el del reloj de v1)
set -euo pipefail
# Sin traza aunque lo lancen con bash -x (o SHELLOPTS=xtrace): enseñaría el token en cada llamada a gh.
{ set +x; } 2> /dev/null

R=${FBR2_REPO:-malolocabreralolo-tech/futbol-base-v2}
TOKEN_FILE=${FBR2_TOKEN_FILE:-$HOME/.config/futbol-base-reloj/token}
SHARE=${XDG_DATA_HOME:-$HOME/.local/share}/futbol-base-v2-reloj

fail() { echo "error: $*" >&2; exit 1; }
first() { head -c "${2:-200}" "$1" | tr '\n' ' ' | sed 's/ *$//'; }

# v1 tiene su propio reloj y no se toca: a su repositorio, este no le pregunta ni le lanza nada. Solo vale la forma
# dueño/nombre (sin .git al final), para que otra forma del de v1 (github.com/…, ….git, la URL entera) no se cuele
# por la comparación. Los caracteres, uno a uno y sin rangos: en es_ES.UTF-8, [a-z] también casa con «á».
ascii='[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]'
[[ $R =~ ^$ascii+/$ascii+$ && ${R,,} != *.git ]] || fail "FBR2_REPO ($R) no tiene la forma dueño/nombre"
[ "${R,,}" != malolocabreralolo-tech/futbol-base ] || fail "FBR2_REPO es el repositorio de v1 ($R): este reloj es solo para v2"

[ -s "$TOKEN_FILE" ] || fail "falta el token de GitHub en $TOKEN_FILE (es el del reloj de v1; FBR2_TOKEN_FILE para leer otro)"
token=$(< "$TOKEN_FILE") || fail "no se puede leer el token de GitHub de $TOKEN_FILE"
[ -n "${token//[[:space:]]/}" ] || fail "falta el token de GitHub en $TOKEN_FILE (el fichero está vacío)"
# Sin exportar: el token va solo en el entorno de cada gh, no en el del resto (python3 de la decisión incluido).
gh() { GH_TOKEN=$token command gh "$@"; }

KEEP="$SHARE/reloj_pasadas.py"
[ -s "$KEEP" ] && [ -s "$SHARE/reloj_pasadas.sha" ] || fail "falta $KEEP: vuelve a ejecutar pc/reloj/instalar.sh"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# 1. ¿Sigue la de main siendo la instalada? Solo para avisar: la decisión es siempre con la instalada.
note=""
if main_sha=$(gh api "repos/$R/contents/scripts/reloj_pasadas.py?ref=main" --jq .sha 2> "$TMP/api.err"); then
  [ "$main_sha" = "$(cat "$SHARE/reloj_pasadas.sha")" ] \
    || note=" AVISO: reloj_pasadas.py ha cambiado en main (${main_sha:0:8}); sigo con la instalada: revísala y vuelve a ejecutar pc/reloj/instalar.sh."
else
  note=" (no se pudo comparar reloj_pasadas.py con main: $(first "$TMP/api.err" 120))"
fi

# 2. ¿Toca? Las mismas ejecuciones de update.yml y la misma decisión que reloj.yml.
gh run list -R "$R" --workflow update.yml --limit 20 \
  --json number,event,status,conclusion,createdAt,startedAt > "$TMP/pasadas.json" 2> "$TMP/gh.err" \
  || fail "gh run list de update.yml: $(first "$TMP/gh.err")"
# -I: sin el directorio del script ni el actual en sys.path.
GITHUB_OUTPUT="$TMP/out" python3 -I "$KEEP" < "$TMP/pasadas.json" > "$TMP/decision" 2>&1 \
  || fail "reloj_pasadas: $(first "$TMP/decision" 300)"
why=$(grep -v '^::' "$TMP/decision" | head -c 400 | tr '\n' ' ' | sed 's/ *$//' || true)
decision=$(grep -xE 'due=(true|false)' "$TMP/out" 2> /dev/null | tail -n 1 || true)
case $decision in
  due=true|due=false) ;;
  *) fail "reloj_pasadas no dio su decisión (due=): $why" ;;
esac

# 2b. Sin pasada del bot: ¿toca el carril de las mayores (carril-mayores.yml) o el carril del histórico (historico.yml)?
# Los lanza reloj.yml, y los ticks de su cron casi no llegan: si este reloj solo lo lanzara cuando toca una pasada, el
# carril (entra entre los 25 y los 75 min de una pasada del bot) y el histórico (cada 3 h) casi nunca tendrían un tick
# en el que decidirse. Mismas listas y misma copia instalada que reloj.yml: due_carril (con --carril y los dos
# --activar) y due_historico (con --historico y los --otros). El carril, como en reloj.yml, solo con la variable del
# repositorio CARRIL_MAYORES a 1 (la lee la API, con el mismo token: tiene que poder leer las variables): sin ella
# (404) o con otro valor, ni se mira ni se nombra, y ningún reloj.yml se lanza por él (si no, con el carril apagado,
# uno en cada tick de su hueco: ~120 al día en vano). El histórico no depende de ella. Con due=true no se mira nada de
# esto (ni una llamada más). Un fallo aquí (la variable que no se lee, una lista que GitHub no da, como
# carril-mayores.yml antes de estar en main; una copia instalada que no conoce el modo; una salida que no se entiende)
# no es un fallo del reloj: se apunta en la línea y sigue con lo que haya (el carril, apagado; sale con 0, como sin
# nada que lanzar).
if [ "$decision" = due=false ]; then
  toca=""
  aviso=""
  declare -A err=()
  carril=0
  if valor=$(gh api "repos/$R/actions/variables/CARRIL_MAYORES" --jq .value 2> "$TMP/gh.err"); then
    [ "$valor" = 1 ] && carril=1
  elif ! grep -q 'HTTP 404' "$TMP/gh.err"; then      # 404: la variable no está puesta, el carril apagado
    aviso+=" No se pudo leer la variable CARRIL_MAYORES: $(first "$TMP/gh.err")."
  fi
  # carril-mayores.yml también con el carril apagado: sus ejecuciones van en los --otros del histórico (si GitHub no la
  # da, sin ella).
  for wf in carril-mayores activar historico; do
    gh run list -R "$R" --workflow "$wf.yml" --limit 20 \
      --json number,event,status,conclusion,createdAt,startedAt > "$TMP/$wf.json" 2> "$TMP/gh.err" \
      || err[$wf]="gh run list de $wf.yml: $(first "$TMP/gh.err")"
  done
  # mirar QUÉ MODO FICHERO CLAVE PREFIJO ARGUMENTOS…: la copia instalada con esos argumentos (MODO, la opción que una
  # copia antigua no conoce: sale con 2, el uso); la línea de su decisión (la que empieza por PREFIJO) va a $toca si
  # CLAVE=true, y un fallo, a $aviso.
  mirar() {
    local que=$1 modo=$2 salida=$3 clave=$4 prefijo=$5 code=0 linea valor
    shift 5
    GITHUB_OUTPUT="$TMP/$salida.out" python3 -I "$KEEP" "$@" > "$TMP/$salida" 2>&1 || code=$?
    if [ "$code" = 2 ]; then
      aviso+=" No se pudo mirar $que: la copia instalada de reloj_pasadas.py no conoce $modo: revísala y vuelve a ejecutar pc/reloj/instalar.sh."
      return 0
    elif [ "$code" != 0 ]; then
      aviso+=" No se pudo mirar $que: $(first "$TMP/$salida" 300)."
      return 0
    fi
    valor=$(grep -xE "$clave=(true|false)" "$TMP/$salida.out" 2> /dev/null | tail -n 1 || true)
    linea=$(grep -m1 "^$prefijo" "$TMP/$salida" | head -c 400 || true)
    case $valor in
      "$clave=true") toca+=" $linea" ;;
      "$clave=false") ;;
      *) aviso+=" No se pudo mirar $que: reloj_pasadas no dio $clave." ;;
    esac
  }
  if [ "$carril" != 1 ]; then
    :
  elif [ -n "${err[carril-mayores]:-}${err[activar]:-}${err[historico]:-}" ]; then
    aviso+=" No se pudo mirar el carril: ${err[carril-mayores]:-${err[activar]:-${err[historico]:-}}}."
  else
    mirar "el carril" --carril carril due_carril "Carril de las categorías mayores: " \
      --carril "$TMP/carril-mayores.json" --activar "$TMP/activar.json" --activar "$TMP/historico.json" < "$TMP/pasadas.json"
  fi
  if [ -n "${err[historico]:-}" ]; then
    aviso+=" No se pudo mirar el histórico: ${err[historico]}."
  else
    # Con las listas que haya: reloj.yml vuelve a mirarlo con todas antes de lanzar nada.
    otros=(--otros "$TMP/pasadas.json")
    [ -z "${err[carril-mayores]:-}" ] && otros+=(--otros "$TMP/carril-mayores.json")
    [ -z "${err[activar]:-}" ] && otros+=(--otros "$TMP/activar.json")
    mirar "el histórico" --historico historico due_historico "Carril del histórico: " \
      --historico "$TMP/historico.json" "${otros[@]}" < /dev/null
  fi
  if [ -z "$toca" ]; then
    echo "$why$aviso$note"
    exit 0
  fi
  why="$why$toca$aviso"
fi

# 3. Toca. No si reloj.yml está desactivado; ni si hay uno en cola o en marcha de hace menos de 30 min (lo lanzó
# el cron de GitHub, o este hace un tick y aún no ha creado la pasada); ni si el último acabó mal hace menos de
# 30 min (sin esto, con reloj.yml fallando, uno cada 5 min y un correo de GitHub por cada fallo). Uno sin acabar
# más viejo es un atasco y no bloquea: el nuevo espera en fila tras él (concurrency reloj-pasadas).
gh api "repos/$R/actions/workflows/reloj.yml" > "$TMP/workflow.json" 2> "$TMP/gh.err" \
  || fail "gh api del workflow reloj.yml: $(first "$TMP/gh.err")"
gh run list -R "$R" --workflow reloj.yml --limit 10 --json status,conclusion,createdAt > "$TMP/relojes.json" 2> "$TMP/gh.err" \
  || fail "gh run list de reloj.yml: $(first "$TMP/gh.err")"
block=$(python3 -I - "$TMP/workflow.json" "$TMP/relojes.json" <<'PY'
import json, sys
from datetime import datetime, timedelta, timezone
state = json.load(open(sys.argv[1])).get("state")
if state == "disabled_inactivity":       # GitHub, tras 60 días sin commits: no lo ha parado nadie
    print("INACTIVO")
    sys.exit()
if state != "active":
    print(f"reloj.yml está «{state}» en Actions")
    sys.exit()
now = datetime.now(timezone.utc)
runs = json.load(open(sys.argv[2]))
for i, run in enumerate(runs):
    ago = now - datetime.fromisoformat(run["createdAt"].replace("Z", "+00:00"))
    mins = int(ago.total_seconds() // 60)
    if run["status"] != "completed" and ago < timedelta(minutes=30):
        print(f"ya hay un reloj.yml {run['status']}, de hace {mins} min")
        break
    if i == 0 and run["status"] == "completed" and run.get("conclusion") in ("failure", "timed_out", "startup_failure") \
            and ago < timedelta(minutes=30):
        print(f"el último reloj.yml acabó en {run['conclusion']} hace {mins} min")
        break
PY
) || fail "no se entienden las respuestas de reloj.yml"
[ "$block" = INACTIVO ] && fail "GitHub desactivó reloj.yml por inactividad: gh workflow enable reloj.yml -R $R"
if [ -n "$block" ]; then
  echo "$why No se lanza: $block.$note"
  exit 0
fi
if [ "${DRY_RUN:-0}" = 1 ]; then
  echo "$why DRY_RUN: no se lanza reloj.yml.$note"
  exit 0
fi
gh workflow run reloj.yml -R "$R" --ref main > /dev/null 2> "$TMP/gh.err" \
  || fail "gh workflow run reloj.yml: $(first "$TMP/gh.err")"
echo "$why Lanzado reloj.yml.$note"
